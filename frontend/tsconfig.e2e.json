{
  /* The browser tests and their config.
   *
   * They need their own project rather than joining tsconfig.app.json: they
   * run in Node, not in the bundle, and they must not inherit the Vitest
   * globals — `expect` and `test` mean different things in Vitest and in
   * Playwright, and a shared project would let a file import one and get the
   * other's types. They need DOM as well as Node because `page.evaluate`
   * runs its callback in the browser.
   *
   * Without this file the e2e directory was in no project at all, so it was
   * neither typechecked nor lintable. */
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["node"],

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,

    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "noEmit": true,
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.e2e.tsbuildinfo"
  },
  "include": ["e2e", "playwright.config.ts"]
}
