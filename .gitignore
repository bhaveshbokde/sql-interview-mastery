# =============================================================================
#  Private study material — never publish
# =============================================================================
#  private-notes/ holds personal interview notes, revision sheets and anything
#  marked local-only. Excluded by DIRECTORY, deliberately not by a blanket
#  *.md rule: the public README, the curriculum index and everything under
#  docs/ must stay version-controlled.
private-notes/
private-notes/revision/
private-notes/interview-prep/

#  Loose personal notes, wherever they land.
NOTES.md
MY-NOTES.md
SCRATCH.md
REVISION-*.md
PERSONAL-*.md
INTERVIEW-*.md
*-INTERVIEW.md
STUDY-*.md

#  Working notes, task plans and implementation diaries. These accumulate
#  during a build and read like documentation without being any: a half-true
#  TODO list committed next to a correct README is worse than no list.
TODO.md
PLAN.md
PLANNING.md
ROADMAP.md
HANDOFF.md
PROGRESS.md
SESSION-*.md
WIP-*.md
notes/
scratch/

#  AI assistant transcripts, prompts and agent state. Nothing here belongs in
#  a repository: a prompt log is a private working document, and a transcript
#  can quote any file it was shown — including the ones above.
.claude/
.cursor/
.aider*
CLAUDE.md
PROMPT*.md
PROMPTS/
*-transcript.md
*-conversation.md
ai-notes/

# =============================================================================
#  Secrets and local environment
# =============================================================================
#  .env is generated by scripts/provision-db.sh and contains real, generated
#  database passwords. .env.example (placeholders only) IS committed.
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.jks
id_rsa*
*.pgpass

# =============================================================================
#  Local database cluster and data
# =============================================================================
#  The user-space PostgreSQL cluster lives outside the repository by default,
#  but these rules cover the case where someone points PGDATA inside it.
pgdata/
.pgdata/
db-local/

# =============================================================================
#  Backend build output
# =============================================================================
target/
build/
out/
*.class
*.jar
*.war
!.mvn/wrapper/*.jar

# =============================================================================
#  Frontend build output and dependencies
# =============================================================================
node_modules/
dist/
dist-ssr/
coverage/

#  Playwright output. Screenshots, traces and videos of failed runs, plus the
#  last-run marker it writes on every invocation. All regenerated; the traces
#  are large and a trace of a failing test can contain whatever was on screen.
test-results/
playwright-report/
blob-report/
.playwright/
playwright/.cache/
.vite/
*.local
vite.config.ts.timestamp-*
.eslintcache

# =============================================================================
#  IDE
# =============================================================================
.idea/
*.iml
*.ipr
*.iws
.vscode/
.settings/
.project
.classpath
.factorypath
nbproject/

# =============================================================================
#  OS
# =============================================================================
.DS_Store
Thumbs.db
*~
.directory

# =============================================================================
#  Logs and local scratch
# =============================================================================
*.log
logs/
hs_err_pid*
replay_pid*
.attach_pid*
scratch/
tmp/
