# =============================================================================
#  sql-interview-mastery — local environment template
# =============================================================================
#  Copy to .env and fill in, or let scripts/provision-db.sh generate it:
#
#      bash scripts/provision-db.sh
#
#  .env is listed in .gitignore and is written with mode 0600. Every value
#  below is a PLACEHOLDER — this file never contains a real credential.
# =============================================================================

# ---- Where PostgreSQL is listening -----------------------------------------
#  5433 is the default for the bundled user-space cluster (scripts/db.sh),
#  chosen so it cannot collide with a system PostgreSQL on 5432.
#  With Docker Compose (docker-compose.yml) the published port is 5433 too.
SQLMASTERY_DB_HOST=127.0.0.1
SQLMASTERY_DB_PORT=5433
SQLMASTERY_DB_NAME=sqlmastery_db
SQLMASTERY_TEST_DB_NAME=sqlmastery_test_db

# ---- Application role -------------------------------------------------------
#  Owns the app and learning schemas and runs Flyway migrations.
#  NOSUPERUSER, NOCREATEDB, NOCREATEROLE.
SQLMASTERY_APP_USERNAME=sqlmastery_app
SQLMASTERY_APP_PASSWORD=replace-me-generated-32-char-password

# ---- Learner role -----------------------------------------------------------
#  The ONLY role that ever executes SQL typed into the playground.
#  Granted CONNECT + USAGE on the learning schema + SELECT on its tables,
#  and nothing else. Its transactions default to READ ONLY at the role level.
#  Never give this role write access or access to the app schema.
SQLMASTERY_LEARNER_USERNAME=sqlmastery_learner
SQLMASTERY_LEARNER_PASSWORD=replace-me-generated-32-char-password

# ---- Playground safety limits ------------------------------------------------
#  All of these are enforced server-side; the frontend only displays them.
SQLMASTERY_PLAYGROUND_STATEMENT_TIMEOUT_MS=3000
SQLMASTERY_PLAYGROUND_MAX_ROWS=500
SQLMASTERY_PLAYGROUND_MAX_SQL_LENGTH=10000

# ---- Server -----------------------------------------------------------------
SQLMASTERY_SERVER_PORT=8085

# ---- CORS -------------------------------------------------------------------
#  Comma-separated. Only relevant when the frontend is served from a different
#  origin than the API — in development that is the Vite dev server, and in a
#  built deployment it is nothing, because nginx proxies /api and the browser
#  sees one origin.
SQLMASTERY_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---- Frontend ---------------------------------------------------------------
#  Used by Vite at dev time. Leave blank to use the dev-server proxy.
VITE_API_BASE_URL=
